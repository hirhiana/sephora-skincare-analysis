<preferences><preference name='ui.encoding.shelf.height' value='24' /><preference name='ui.shelf.height' value='26' /></preferences>
<datasources><datasource caption='Review Summary' inline='true' name='federated.reviewsummary01' version='18.1'>
 <connection class='federated'>
  <named-connections><named-connection caption='Review Summary' name='textscan.rs01'>
   <connection class='textscan' directory='/Users/thiivy/Desktop/Portfolio/sephora-project/tableau' filename='sephora_review_summary.csv' password='' server='' />
  </named-connection></named-connections>
  <relation connection='textscan.rs01' name='sephora_review_summary.csv' table='[sephora_review_summary#csv]' type='table'>
   <columns character-set='UTF-8' header='yes' locale='en_US' separator=','><column datatype='string' name='category' ordinal='0' /><column datatype='string' name='price_tier' ordinal='1' /><column datatype='string' name='skin_type' ordinal='2' /><column datatype='string' name='skin_tone_group' ordinal='3' /><column datatype='integer' name='reviews' ordinal='4' /><column datatype='integer' name='detractors' ordinal='5' /><column datatype='integer' name='detractors_white_cast' ordinal='6' /><column datatype='integer' name='star_sum' ordinal='7' /></columns>
  </relation>
 </connection>
 <column caption='Detractor Rate' datatype='real' default-format='p0.0%' name='[Calc_DetRate]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([detractors])/SUM([reviews])' /></column>
 <column caption='White Cast Share of Complaints' datatype='real' default-format='p0%' name='[Calc_WC]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([detractors_white_cast])/SUM([detractors])' /></column>
 <column caption='Reviews' datatype='integer' default-format='n#,##0' name='[reviews]' role='measure' type='quantitative' />
 <column caption='Category' datatype='string' name='[category]' role='dimension' type='nominal' />
 <column caption='Price Tier' datatype='string' name='[price_tier]' role='dimension' type='nominal' />
