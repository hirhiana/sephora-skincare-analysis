  <connection access_mode='readonly' authentication='auth-none' author-locale='en_US' class='hyper' dbname='/Users/thiivy/Desktop/Portfolio/sephora-project/tableau/review_summary.hyper' default-settings='hyper' schema='Extract' sslmode='' tablename='Extract' update-time='11/05/2026 12:30:00 PM' username='tableau'>
