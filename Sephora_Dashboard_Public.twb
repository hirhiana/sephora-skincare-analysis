<worksheets><worksheet name='Detractor Rate by Category'><layout-options><title><formatted-text><run fontsize='12' bold='true'>Where are customers unhappy? Detractor rate (1–2 star reviews) by category</run></formatted-text></title></layout-options>
 <table>
  <view><datasources><datasource name='federated.reviewsummary01' /></datasources><datasource-dependencies datasource='federated.reviewsummary01'><column caption='Category' datatype='string' name='[category]' role='dimension' type='nominal' /><column caption='Detractor Rate' datatype='real' default-format='p0.0%' name='[Calc_DetRate]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([detractors])/SUM([reviews])' /></column><column datatype='integer' name='[detractors]' role='measure' type='quantitative' /><column caption='Reviews' datatype='integer' name='[reviews]' role='measure' type='quantitative' /><column caption='Highlight' datatype='integer' name='[Calc_Flag1]' role='measure' type='quantitative'><calculation class='tableau' formula='IF [Calc_DetRate] &gt; 0.13 THEN 1 ELSE 0 END' /></column><column-instance column='[category]' derivation='None' name='[none:category:nk]' pivot='key' type='nominal' /><column-instance column='[Calc_DetRate]' derivation='User' name='[usr:Calc_DetRate:qk]' pivot='key' type='quantitative' /><column-instance column='[Calc_Flag1]' derivation='User' name='[usr:Calc_Flag1:qk]' pivot='key' type='quantitative' /></datasource-dependencies><filter class='categorical' column='[federated.reviewsummary01].[none:category:nk]'><groupfilter function='except' user:ui-domain='database' user:ui-enumeration='exclusive' user:ui-marker='enumerate'><groupfilter function='level-members' level='[none:category:nk]' /><groupfilter function='member' level='[none:category:nk]' member='&quot;Shop by Concern&quot;' /></groupfilter></filter><sort class='computed' column='[federated.reviewsummary01].[none:category:nk]' direction='DESC' using='[federated.reviewsummary01].[usr:Calc_DetRate:qk]' /><slices><column>[federated.reviewsummary01].[none:category:nk]</column></slices><aggregation value='true' /></view>
  <style><style-rule element='mark'><encoding attr='color' field='[federated.reviewsummary01].[usr:Calc_Flag1:qk]' type='custom-interpolated'><color-palette custom='true' name='' type='ordered-sequential'><color>#d6d3d1</color><color>#9d174d</color></color-palette></encoding></style-rule></style>
  <panes><pane selection-relaxation-option='selection-relaxation-allow'><view><breakdown value='auto' /></view><mark class='Bar' /><encodings><color column='[federated.reviewsummary01].[usr:Calc_Flag1:qk]' /><text column='[federated.reviewsummary01].[usr:Calc_DetRate:qk]' /></encodings><style><style-rule element='mark'><format attr='mark-labels-show' value='true' /></style-rule></style></pane></panes>
  <rows>[federated.reviewsummary01].[none:category:nk]</rows><cols>[federated.reviewsummary01].[usr:Calc_DetRate:qk]</cols>
 </table>
</worksheet><worksheet name='Sunscreen White Cast by Skin Tone'><layout-options><title><formatted-text><run fontsize='12' bold='true'>Who is affected? Share of unhappy sunscreen reviews mentioning white cast (Rich/Dark omitted: only 28 complaints)</run></formatted-text></title></layout-options>
 <table>
  <view><datasources><datasource name='federated.reviewsummary01' /></datasources><datasource-dependencies datasource='federated.reviewsummary01'><column caption='Category' datatype='string' name='[category]' role='dimension' type='nominal' /><column caption='Skin Tone' datatype='string' name='[skin_tone_group]' role='dimension' type='nominal' /><column caption='White Cast Share of Complaints' datatype='real' default-format='p0%' name='[Calc_WC]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([detractors_white_cast])/SUM([detractors])' /></column><column datatype='integer' name='[detractors_white_cast]' role='measure' type='quantitative' /><column caption='Highlight Tone' datatype='integer' name='[Calc_Flag2]' role='measure' type='quantitative'><calculation class='tableau' formula='IF [Calc_WC] &gt; 0.25 THEN 1 ELSE 0 END' /></column><column-instance column='[category]' derivation='None' name='[none:category:nk]' pivot='key' type='nominal' /><column-instance column='[skin_tone_group]' derivation='None' name='[none:skin_tone_group:nk]' pivot='key' type='nominal' /><column-instance column='[Calc_WC]' derivation='User' name='[usr:Calc_WC:qk]' pivot='key' type='quantitative' /><column-instance column='[Calc_Flag2]' derivation='User' name='[usr:Calc_Flag2:qk]' pivot='key' type='quantitative' /></datasource-dependencies><filter class='categorical' column='[federated.reviewsummary01].[none:category:nk]'><groupfilter function='member' level='[none:category:nk]' member='&quot;Sunscreen&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' /></filter>
<filter class='categorical' column='[federated.reviewsummary01].[none:skin_tone_group:nk]'><groupfilter function='except' user:ui-domain='database' user:ui-enumeration='exclusive' user:ui-marker='enumerate'><groupfilter function='level-members' level='[none:skin_tone_group:nk]' /><groupfilter function='union'><groupfilter function='member' level='[none:skin_tone_group:nk]' member='&quot;Not reported&quot;' /><groupfilter function='member' level='[none:skin_tone_group:nk]' member='&quot;9. Rich/Dark&quot;' /></groupfilter></groupfilter></filter>
<slices><column>[federated.reviewsummary01].[none:category:nk]</column><column>[federated.reviewsummary01].[none:skin_tone_group:nk]</column></slices><aggregation value='true' /></view>
  <style><style-rule element='mark'><encoding attr='color' field='[federated.reviewsummary01].[usr:Calc_Flag2:qk]' type='custom-interpolated'><color-palette custom='true' name='' type='ordered-sequential'><color>#d6d3d1</color><color>#9d174d</color></color-palette></encoding></style-rule></style>
  <panes><pane selection-relaxation-option='selection-relaxation-allow'><view><breakdown value='auto' /></view><mark class='Bar' /><encodings><color column='[federated.reviewsummary01].[usr:Calc_Flag2:qk]' /><text column='[federated.reviewsummary01].[usr:Calc_WC:qk]' /></encodings><style><style-rule element='mark'><format attr='mark-labels-show' value='true' /></style-rule></style></pane></panes>
  <rows>[federated.reviewsummary01].[usr:Calc_WC:qk]</rows><cols>[federated.reviewsummary01].[none:skin_tone_group:nk]</cols>
 </table>
</worksheet><worksheet name='Price Tier x Category'><layout-options><title><formatted-text><run fontsize='12' bold='true'>Does price buy satisfaction? Detractor rate by price tier (blank = under 500 reviews)</run></formatted-text></title></layout-options>
 <table>
  <view><datasources><datasource name='federated.reviewsummary01' /></datasources><datasource-dependencies datasource='federated.reviewsummary01'><column caption='Category' datatype='string' name='[category]' role='dimension' type='nominal' /><column caption='Price Tier' datatype='string' name='[price_tier]' role='dimension' type='nominal' /><column caption='Detractor Rate (500+ reviews)' datatype='real' default-format='p0.0%' name='[Calc_Det500]' role='measure' type='quantitative'><calculation class='tableau' formula='IF SUM([reviews]) &gt;= 500 THEN SUM([detractors])/SUM([reviews]) END' /></column><column datatype='integer' name='[detractors]' role='measure' type='quantitative' /><column caption='Reviews' datatype='integer' name='[reviews]' role='measure' type='quantitative' /><column-instance column='[category]' derivation='None' name='[none:category:nk]' pivot='key' type='nominal' /><column-instance column='[price_tier]' derivation='None' name='[none:price_tier:nk]' pivot='key' type='nominal' /><column-instance column='[Calc_Det500]' derivation='User' name='[usr:Calc_Det500:qk]' pivot='key' type='quantitative' /></datasource-dependencies><filter class='categorical' column='[federated.reviewsummary01].[none:category:nk]'><groupfilter function='except' user:ui-domain='database' user:ui-enumeration='exclusive' user:ui-marker='enumerate'><groupfilter function='level-members' level='[none:category:nk]' /><groupfilter function='member' level='[none:category:nk]' member='&quot;Shop by Concern&quot;' /></groupfilter></filter><slices><column>[federated.reviewsummary01].[none:category:nk]</column></slices><aggregation value='true' /></view>
  <style><style-rule element='mark'><encoding attr='color' field='[federated.reviewsummary01].[usr:Calc_Det500:qk]' type='custom-interpolated'><color-palette custom='true' name='' type='ordered-sequential'><color>#fce7f3</color><color>#9d174d</color></color-palette></encoding></style-rule></style>
  <panes><pane selection-relaxation-option='selection-relaxation-allow'><view><breakdown value='auto' /></view><mark class='Square' /><encodings><color column='[federated.reviewsummary01].[usr:Calc_Det500:qk]' /><text column='[federated.reviewsummary01].[usr:Calc_Det500:qk]' /></encodings><style><style-rule element='mark'><format attr='mark-labels-show' value='true' /></style-rule></style></pane></panes>
  <rows>[federated.reviewsummary01].[none:category:nk]</rows><cols>[federated.reviewsummary01].[none:price_tier:nk]</cols>
 </table>
</worksheet><worksheet name='Product Explorer'><layout-options><title><formatted-text><run fontsize='12' bold='true'>Product explorer: price vs. detractor rate (products with 100+ reviews; size = reviews)</run></formatted-text></title></layout-options>
 <table>
  <view><datasources><datasource name='federated.products0001' /></datasources><datasource-dependencies datasource='federated.products0001'><column caption='Detractor Rate' datatype='real' default-format='p0.0%' name='[detractor_rate]' role='measure' type='quantitative' /><column caption='Price (USD)' datatype='real' name='[price_usd]' role='measure' type='quantitative' /><column caption='Reviews' datatype='integer' name='[reviews]' role='measure' type='quantitative' /><column caption='Product' datatype='string' name='[product_name]' role='dimension' type='nominal' /><column caption='Brand' datatype='string' name='[brand]' role='dimension' type='nominal' /><column caption='Category' datatype='string' name='[category]' role='dimension' type='nominal' /><column-instance column='[detractor_rate]' derivation='Avg' name='[avg:detractor_rate:qk]' pivot='key' type='quantitative' /><column-instance column='[price_usd]' derivation='Avg' name='[avg:price_usd:qk]' pivot='key' type='quantitative' /><column-instance column='[reviews]' derivation='Sum' name='[sum:reviews:qk]' pivot='key' type='quantitative' /><column-instance column='[product_name]' derivation='None' name='[none:product_name:nk]' pivot='key' type='nominal' /><column-instance column='[brand]' derivation='None' name='[none:brand:nk]' pivot='key' type='nominal' /><column-instance column='[category]' derivation='None' name='[none:category:nk]' pivot='key' type='nominal' /></datasource-dependencies><aggregation value='true' /></view>
  <style></style>
  <panes><pane selection-relaxation-option='selection-relaxation-allow'><view><breakdown value='auto' /></view><mark class='Circle' /><encodings><size column='[federated.products0001].[sum:reviews:qk]' /><lod column='[federated.products0001].[none:product_name:nk]' /><lod column='[federated.products0001].[none:brand:nk]' /><lod column='[federated.products0001].[none:category:nk]' /></encodings><style><style-rule element='mark'><format attr='mark-color' value='#9d174d' /><format attr='mark-transparency' value='140' /></style-rule></style></pane></panes>
  <rows>[federated.products0001].[avg:detractor_rate:qk]</rows><cols>[federated.products0001].[avg:price_usd:qk]</cols>
 </table>
